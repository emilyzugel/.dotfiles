/**
 * App Launcher
 * Blackout Theme
 */

* {
    font: "JetBrains Mono 11";
    background:          #1E1D2FE6;
    background-alt:      #282839FF;
    foreground:          #D9E0EEFF;
    foreground-alt:      #D9E0EEAA;
    selected:            #B4BEFEE6;
    selected-foreground: #1E1D2F;
    active:              #ABE9B3E6;
    urgent:              #F28FADE6;
}

/***** Configuration *****/
configuration {
    modi: "drun,filebrowser,window";
    show-icons: false;
    display-drun: "APPS";
    display-filebrowser: "FILES";
    display-window: "WIN";
    drun-display-format: "{name}";
    window-format: "{w} · {c} · {t}";
}

/***** Window *****/
window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 800px;
    border-radius: 15px;
    background-color: @background;
}

/***** Main Layout *****/
mainbox {
    orientation: horizontal;
    spacing: 0px;
    background-color: transparent;
    children: [
        "imagebox",
        "listbox"
    ];
}

/***** Left Side *****/
imagebox {
    padding: 20px;
    background-color: transparent;
    background-image: url("~/walls/pixelart-landscape-1.jpg", height);
    orientation: vertical;
    children: [
        "inputbar",
        "dummy",
        "mode-switcher"
    ];
}

dummy {
    background-color: transparent;
}

/***** Right Side *****/
listbox {
    spacing: 20px;
    padding: 20px;
    background-color: transparent;
    orientation: vertical;
    children: [
        "message",
        "listview"
    ];
}

/***** Search *****/
inputbar {
    spacing: 10px;
    padding: 15px;
    border-radius: 10px;
    background-color: @background-alt;
    text-color: @foreground;
    children: [
        "textbox-prompt-colon",
        "entry"
    ];
}

textbox-prompt-colon {
    expand: false;
    str: " ";
    background-color: transparent;
    text-color: @foreground;
}

entry {
    placeholder: "Search";
    background-color: transparent;
    text-color: @foreground;
    placeholder-color: @foreground-alt;
}

/***** Buttons *****/
mode-switcher {
    spacing: 20px;
    background-color: transparent;
    text-color: @foreground;
}

button {
    padding: 15px;
    border-radius: 10px;
    background-color: @background-alt;
    text-color: @foreground;
}

button selected {
    background-color: @selected;
    text-color: @selected-foreground;
}

/***** Apps List *****/
listview {
    columns: 1;
    lines: 8;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    spacing: 10px;
    background-color: transparent;
    text-color: @foreground;
}

element {
    padding: 8px;
    border-radius: 10px;
    background-color: transparent;
    text-color: @foreground;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground-alt;
}

element selected.normal {
    background-color: @selected;
    text-color: @selected-foreground;
}

element-icon {
    size: 32px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

/***** Message *****/

message {
    background-color: transparent;
}

textbox {
    padding: 15px;
    border-radius: 10px;
    background-color: @background-alt;
    text-color: @foreground;
}
