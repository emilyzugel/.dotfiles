/**
 * Power Launcher
 * Blackout Theme
 */

/***** Global *****/
* {
    font: "JetBrains Mono 9";
    background:     #1E1D2FE6;
    background-alt: #282839E6;
    foreground:     #D9E0EEFF;
    selected:       #B4BEFEE6;
    selected-fg:    #1E1D2FE6;
    active:         #ABE9B3E6;
    urgent:         #F28FADE6;
}

configuration {
    show-icons: false;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 600px;
    padding: 30px;
    border-radius: 20px;
    background-color: @background;
}

mainbox {
    spacing: 0px;
    margin: 0px;
    padding: 0px;
    background-color: transparent;
    children: [ "listview", "message" ];
}

/***** List *****/
listview {
    columns: 3;
    lines: 1;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    fixed-height: true;
    fixed-columns: true;
    spacing: 30px;
    margin: 30px;
    background-color: transparent;
    cursor: default;
}

/***** Buttons *****/
element {
    padding: 20px 20px 30px 20px;
    border-radius: 15px;
    background-color: @background-alt;
    text-color: @foreground;
    cursor: pointer;
}

element normal.normal {
    background-color: @background-alt;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color: @selected-fg;
}

/***** Text *****/
element-text {
    font: "feather bold 32";
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

message {
    enabled: true;
    margin: 0px;
    padding: 15px;
    border-radius: 15px;
    background-color: transparent;
    text-color: @foreground;
}

textbox {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}
